<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for CoreHUD (paste this into the SignPath project's artifact configuration).
  The release workflow (.github/workflows/release.yml) uploads bin\CoreHUD.exe as a GitHub artifact, which GitHub
  stores as a ZIP - hence the <zip-file> root. The metadata restrictions make SignPath refuse to sign anything
  that isn't CoreHUD at exactly the version being released (the workflow passes "version" from src\version.h).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="CoreHUD.exe" product-name="CoreHUD" product-version="${version}" file-version="${version}"
             original-filename="CoreHUD.exe">
      <authenticode-sign description="CoreHUD" description-url="https://github.com/lotusspeculosus/CoreHUD" />
    </pe-file>
  </zip-file>
</artifact-configuration>
