// Windows version resource (Explorer: right-click CoreHUD.exe > Properties > Details)
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    COREHUD_VER_MAJOR, COREHUD_VER_MINOR, COREHUD_VER_PATCH, 0
 PRODUCTVERSION COREHUD_VER_MAJOR, COREHUD_VER_MINOR, COREHUD_VER_PATCH, 0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "CoreHUD contributors"
            VALUE "FileDescription",  "CoreHUD - hardware monitor, sensor panel and 12V-2x6 protection"
            VALUE "FileVersion",      COREHUD_VERSION_STR
            VALUE "InternalName",     "CoreHUD"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "CoreHUD.exe"
            VALUE "ProductName",      "CoreHUD"
            VALUE "ProductVersion",   COREHUD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
