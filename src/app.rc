// Windows version resource (Explorer: right-click RigSense.exe > Properties > Details)
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    RIGSENSE_VER_MAJOR, RIGSENSE_VER_MINOR, RIGSENSE_VER_PATCH, 0
 PRODUCTVERSION RIGSENSE_VER_MAJOR, RIGSENSE_VER_MINOR, RIGSENSE_VER_PATCH, 0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RigSense contributors"
            VALUE "FileDescription",  "RigSense - hardware monitor, sensor panel and 12V-2x6 protection"
            VALUE "FileVersion",      RIGSENSE_VERSION_STR
            VALUE "InternalName",     "RigSense"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "RigSense.exe"
            VALUE "ProductName",      "RigSense"
            VALUE "ProductVersion",   RIGSENSE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
